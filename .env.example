# Copy this file to .env and fill in real values.
# NEVER commit .env. NEVER paste the private key anywhere but this local file.

# RPC endpoint for Robinhood Chain (ask your RPC provider / chain docs for this)
RPC_URL=

# Chain ID for Robinhood Chain (confirm the exact number before running)
CHAIN_ID=

# Private key of the FRESH, single-purpose EOA that holds the minted reserve NFTs.
# This wallet should hold nothing else of value. Generate it specifically for this job.
PRIVATE_KEY=

# The Ruxxells NFT contract address
NFT_CONTRACT=

# The Safe multisig address that should receive the NFTs
SAFE_ADDRESS=

# Token IDs to transfer. Comma-separated list and/or ranges, e.g.:
#   1,2,3,10-20,42
TOKEN_IDS=

# How many block confirmations to wait for per transfer (1 is usually fine)
CONFIRMATIONS=1
